NODE_ENV=development
PORT=3000
POSTGRES_PASSWORD=replace-with-a-strong-local-password
DATABASE_URL=postgres://trix_user:replace-with-a-strong-local-password@localhost:5432/trix_pharmacy
JWT_SECRET=replace-with-at-least-32-random-bytes
APP_ORIGIN=http://localhost:3000
# Set TRUST_PROXY=1 only when deployed behind your trusted HTTPS reverse proxy.
TRUST_PROXY=0
# SMTP is required to send verification links. Until configured, registration will not enable access.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MP PHARMAI <no-reply@example.com>
PUBLIC_APP_URL=http://localhost:3000

# First-run administrator bootstrap. Set a private random secret (at least 20 chars).
ADMIN_EMAIL=muhozapatrick11@gmail.com
ADMIN_BOOTSTRAP_SECRET=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET_AT_LEAST_20_CHARACTERS


# Subscription/payment configuration
# Use test only for local development. In Render production, set PAYMENT_PROVIDER_MODE=flutterwave.
PAYMENT_PROVIDER_MODE=test
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_WEBHOOK_SECRET_HASH=
# Comma-separated email address(es) allowed to see the platform-owner revenue dashboard.
PLATFORM_OWNER_EMAILS=

# Mobile Money recipient displayed in billing. Confirm ownership and format before launch.
MOMO_PAYMENT_NUMBER=+25079829779
